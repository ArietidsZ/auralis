#!/usr/bin/env python3
"""Generate native Auralis icons from the single SVG mark; requires rsvg-convert."""
import json
from pathlib import Path
import shutil
import subprocess
import xml.etree.ElementTree as ET

ROOT = Path(__file__).resolve().parents[1]
SOURCE = ROOT / 'docs/brand/mark.svg'
svg = ET.parse(SOURCE).getroot()
ns = {'s': 'http://www.w3.org/2000/svg'}
background = svg.find('s:rect', ns).get('fill')
mark = svg.find("s:g[@id='mark']", ns)
paths = list(mark)
android = ROOT / 'android/app/src/main/res'

for name, mono in [('ic_launcher_foreground', False), ('ic_launcher_monochrome', True)]:
    rows = ['<?xml version="1.0" encoding="utf-8"?>',
            '<!-- Generated by scripts/build_brand_assets from docs/brand/mark.svg -->',
            '<vector xmlns:android="http://schemas.android.com/apk/res/android"',
            '    android:width="108dp" android:height="108dp"',
            '    android:viewportWidth="108" android:viewportHeight="108">']
    for path in paths:
        color = '#FFFFFF' if mono else path.get('stroke')
        rows += ['    <path android:fillColor="#00000000"',
                 f'        android:strokeColor="{color}" android:strokeWidth="{path.get("stroke-width")}"',
                 '        android:strokeLineCap="round" android:strokeLineJoin="round"',
                 f'        android:pathData="{path.get("d")}" />']
    rows.append('</vector>')
    (android / 'drawable' / (name + '.xml')).write_text('\n'.join(rows) + '\n')
(android / 'values/ic_launcher_colors.xml').write_text(
    '<?xml version="1.0" encoding="utf-8"?>\n<resources>\n'
    f'    <color name="ic_launcher_background">{background}</color>\n</resources>\n')

renderer = shutil.which('rsvg-convert')
if not renderer:
    raise SystemExit('rsvg-convert is required to regenerate the committed iOS icons')
assets = ROOT / 'ios/DialectInterpreter/Assets.xcassets'
icons = assets / 'AppIcon.appiconset'
icons.mkdir(parents=True, exist_ok=True)
entries = []
for idiom, sizes in [('iphone', [(20,2),(20,3),(29,2),(29,3),(40,2),(40,3),(60,2),(60,3)]),
                     ('ipad', [(20,1),(20,2),(29,1),(29,2),(40,1),(40,2),(76,1),(76,2),(83.5,2)]),
                     ('ios-marketing', [(1024,1)]),
                     ('mac', [(16,1),(16,2),(32,1),(32,2),(128,1),(128,2),(256,1),(256,2),(512,1),(512,2)])]:
    for size, scale in sizes:
        pixels = int(size * scale)
        entries.append(dict(idiom=idiom, size=f'{size}x{size}', scale=f'{scale}x', filename=f'Icon-{pixels}.png'))
for pixels in sorted({int(float(e['size'].split('x')[0]) * int(e['scale'][:-1])) for e in entries}):
    subprocess.run([renderer, '-w', str(pixels), '-h', str(pixels), '-o', str(icons/f'Icon-{pixels}.png'), str(SOURCE)], check=True)
(icons / 'Contents.json').write_text(json.dumps(dict(images=entries, info=dict(author='xcode', version=1)), indent=2)+'\n')
(assets / 'Contents.json').write_text(json.dumps(dict(info=dict(author='xcode', version=1)), indent=2)+'\n')
accent = assets / 'AccentColor.colorset'
accent.mkdir(exist_ok=True)
(accent / 'Contents.json').write_text(json.dumps(dict(colors=[
    dict(idiom='universal', color={'color-space':'srgb', 'components':{'red':'0x21','green':'0x6B','blue':'0x62','alpha':'1.000'}}),
    dict(idiom='universal', appearances=[dict(appearance='luminosity',value='dark')],
         color={'color-space':'srgb','components':{'red':'0x63','green':'0xB3','blue':'0xA4','alpha':'1.000'}})
], info=dict(author='xcode',version=1)), indent=2)+'\n')
print(f'Generated Android vectors and {len(list(icons.glob("*.png")))} opaque iOS icon sizes from {SOURCE.relative_to(ROOT)}')
