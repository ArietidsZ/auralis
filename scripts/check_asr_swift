#!/usr/bin/env python3
"""Compile and execute real Swift ASR against the installed sherpa C API.

Explicit model/sample paths required. No download or stub implementation.
Exit 0 pass, 1 compile/runtime failure, 2 missing environment, 4 input error.
"""
import argparse
import json
import platform
import shutil
import struct
import subprocess
import sys
from pathlib import Path

ROOT = Path(__file__).resolve().parents[1]
sys.path.insert(0, str(ROOT / "convert"))
from asr_runner import load_wav, read_transcript_index
from manifest_contract import ArgParser
from model_tasks import file_hash


def main():
    parser = ArgParser(description=__doc__)
    parser.add_argument("--python", required=True, help="Python with pinned sherpa-onnx installed")
    parser.add_argument("--models-dir", required=True, type=Path)
    parser.add_argument("--samples-dir", required=True, type=Path)
    parser.add_argument("--output", required=True, type=Path)
    args = parser.parse_args()
    if platform.system() != "Darwin" or not shutil.which("swiftc") or not shutil.which("clang"):
        print("blocked: macOS Swift/Clang required", file=sys.stderr)
        return 2
    args.output.mkdir(parents=True, exist_ok=True)
    output = args.output.resolve()
    try:
        package = Path(subprocess.check_output([args.python, "-c",
            "import pathlib,sherpa_onnx;print(pathlib.Path(sherpa_onnx.__file__).parent)"], text=True).strip())
        include = package / "include/sherpa-onnx/c-api"
        library = package / "lib"
        if not (include / "c-api.h").is_file() or not (library / "libsherpa-onnx-c-api.dylib").is_file():
            print("blocked: official sherpa C API header/library missing", file=sys.stderr)
            return 2
        wav = args.samples_dir / "de.wav"
        audio = load_wav(wav)
        if audio.sample_rate != 16000 or audio.channels != 1:
            parser.error("German fixture must be original mono 16 kHz PCM")
        reference = read_transcript_index(args.samples_dir / "transcript.txt")["de"]
        (output / "de.f32").write_bytes(struct.pack(f"<{len(audio.samples)}f", *audio.samples))
        (output / "reference.txt").write_text(reference, encoding="utf-8")
    except (OSError, subprocess.CalledProcessError) as exc:
        print(f"blocked: {exc}", file=sys.stderr)
        return 2
    main_source = '''import Foundation
do {
    let args = CommandLine.arguments
    let report = try await AsrRuntimeChecks.run(modelsRoot: URL(fileURLWithPath: args[1]),
        pcmURL: URL(fileURLWithPath: args[2]), reference: String(contentsOfFile: args[3], encoding: .utf8))
    let data = try JSONSerialization.data(withJSONObject: report, options: [.prettyPrinted, .sortedKeys])
    try data.write(to: URL(fileURLWithPath: args[4]))
    print(String(data: data, encoding: .utf8)!)
} catch { print("ASR runtime check failed: \\(error)"); exit(1) }
'''
    (output / "main.swift").write_text(main_source, encoding="utf-8")
    bridge = ROOT / "ios/DialectInterpreter/Inference/SherpaOnnx"
    source = ROOT / "ios/DialectInterpreter"
    commands = [
        ["clang", "-std=c11", "-c", str(bridge / "auralis_sherpa_asr.c"), "-I", str(include),
         "-o", str(output / "bridge.o")],
        ["swiftc", "-swift-version", "5", "-module-cache-path", str(output / "module-cache"),
         "-I", str(bridge), *map(str, sorted((source / "Data").glob("*.swift"))),
         str(source / "Inference/AsrEngine.swift"), str(ROOT / "ios/DialectInterpreterTests/AsrRuntimeChecks.swift"),
         str(output / "main.swift"), str(output / "bridge.o"), "-L", str(library), "-lsherpa-onnx-c-api",
         "-Xlinker", "-rpath", "-Xlinker", str(library), "-o", str(output / "asr-checks")],
        [str(output / "asr-checks"), str(args.models_dir.resolve()), str(output / "de.f32"),
         str(output / "reference.txt"), str(output / "checks.json")],
    ]
    for index, command in enumerate(commands):
        with (output / f"step-{index}.log").open("w") as log:
            result = subprocess.run(command, stdout=log, stderr=subprocess.STDOUT, timeout=600)
        if result.returncode:
            print(f"failed: step {index}, exit {result.returncode}; see {output / f'step-{index}.log'}")
            return 1
    (output / "provenance.json").write_text(json.dumps({"commands": commands,
        "audioSha256": file_hash(wav), "transcriptsSha256": file_hash(args.samples_dir / "transcript.txt"),
        "librarySha256": file_hash(library / "libsherpa-onnx-c-api.dylib")}, indent=2) + "\n")
    print((output / "checks.json").read_text())
    return 0


if __name__ == "__main__":
    sys.exit(main())
