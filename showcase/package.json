{
  "name": "auralis-showcase",
  "version": "0.1.0",
  "private": true,
  "license": "Apache-2.0",
  "type": "module",
  "scripts": {
    "check": "tsc --noEmit",
    "studio": "remotion studio src/index.ts --public-dir=../docs/brand",
