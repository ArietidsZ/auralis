  },
  "dependencies": {
    "@remotion/cli": "4.0.522",
    "remotion": "4.0.522",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "typescript": "7.0.2",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.7"
  }
}
